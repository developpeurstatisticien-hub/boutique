# Supabase Postgres: use the Session pooler URL here if the direct database host
# is unavailable over IPv4. Do not use the /rest/v1/ URL or the publishable API key.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Direct PostgreSQL URL from Supabase for Prisma migrations.
DIRECT_URL="postgresql://postgres:DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
LOCAL_POSTGRES_PASSWORD=""
LOCAL_MEDIA_STORAGE="false"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_BASE_URL=""
PAYMENT_BANKILY_NUMBER="+222 41 64 99 04"
PAYMENT_MASRVI_NUMBER="+222 41 64 99 04"
PAYMENT_SEDAD_NUMBER="+222 41 64 99 04"
